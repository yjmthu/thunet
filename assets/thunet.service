[Unit]
Description=THUnet campus network client (background core)
Documentation=https://github.com/yjmthu/thunet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=thunet
StateDirectoryMode=0700
# The trust anchor for the machine endpoint. The state directory cannot serve
# that purpose: with `DynamicUser=` the real directory lives in
# /var/lib/private/thunet (mode 0700 root:root), so the /var/lib/thunet symlink
# cannot even be stat()ed by an unprivileged frontend and every window would
# refuse the real service. This directory is owned by the service account and
# world-readable, and systemd removes it again when the unit stops.
RuntimeDirectory=thunet
RuntimeDirectoryMode=0755
UMask=0077
ExecStart=/usr/bin/thunet core --machine
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LimitCORE=0

[Install]
WantedBy=multi-user.target
