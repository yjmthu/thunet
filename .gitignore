# pixi environments
.pixi/*
!.pixi/config.toml

# Cargo build output
target/

# packaging output (msi / deb / tarball, winget manifests)
dist/

# local build / probe leftovers
*.log
*.pdb
__pycache__/
*.pyc

# runtime state: never part of the repository (use fake values in examples)
credential.bin
key.bin
config.json
core.log
crash.log

# installers are built into dist/ and uploaded as release assets
*.msi
*.deb
*.tar.gz

# editor / OS droppings
.vscode/
.DS_Store
Thumbs.db
