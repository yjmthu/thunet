<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-machine MSI for THUnet (see README §7): installs to
  %ProgramFiles%\THUnet and asks for administrator rights once. The executable
  goes to `bin` under it, which is also appended to the system PATH.

  The background core is a Windows service, i.e. a machine-wide resource, so
  the package has to be able to stop and delete it; a per-user package runs
  unelevated and could do neither. Settings stay per user (`%APPDATA%`), and
  the service itself is still registered by the application, because its state
  directory argument points at the configuration of the user who enabled it.

  Build with:  pixi run -e package msi
  Version is required and comes from Cargo.toml: -d Version=<x.y.z>
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="THUnet"
      Manufacturer="THUnet contributors"
      Version="$(var.Version)"
      UpgradeCode="8F0A6F2E-1F1B-4A0F-9C63-2E7A6F0C91D2"
      Scope="perMachine"
      Compressed="yes">

    <!-- Uninstalling the old product before installing the new one keeps a
         single entry in "Installed apps". Same-version upgrades are allowed so
         a rebuilt package can replace the installed one. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of THUnet is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets/thunet.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- The Windows Installer Restart Manager prompts "the following
         applications should be closed" while the UI sequence costs the
         install, which happens before any custom action runs. This package
         asks the window to quit itself and the Service Control Manager to stop
         the core, both before the files are touched, so the prompt is
         redundant: disable the Restart Manager integration. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <!-- ARP values are copied verbatim from the Property table, so a literal
         `[INSTALLFOLDER]` would end up in the registry unexpanded. Format it at
         CostFinalize instead: winget (and the repository validation) locate the
         installed application through this `InstallLocation` value. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]"
                 After="CostFinalize" Sequence="both" />

    <!-- Start the app once the (interactive) transaction is over: a first
         install, an upgrade or a repair all end with a closed copy because of
         `QuitAllWindows`, so the condition must not be limited to
         `NOT Installed` - otherwise double-clicking the package again silently
         leaves no app running. Silent installs such as `msiexec /qn` or winget
         keep UILevel = 2 and stay quiet.

         The launch goes through the desktop shell's own `ShellExecute`, not
         through a new `explorer.exe` (which this elevated action would start
         elevated, and which intermittently showed a folder window instead of
         the app). The shell owns the interactive token, so the tray belongs to
         the user who installed. -->
    <!-- Set at CostFinalize in the execute sequence: `[BINDIR]` is a directory
         property and only resolves once the directories are costed. -->
    <SetProperty Id="WixUnelevatedShellExecTarget" Value="[BINDIR]thunet.exe"
                 After="CostFinalize" Sequence="execute" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Return="ignore" />

    <!-- Remove the service on a real uninstall only. A major upgrade also runs
         this product's uninstall, and `UPGRADINGPRODUCTCODE` is what tells the
         two apart; without the condition every upgrade would silently drop the
         autostart registration. Deferred + Impersonate="no" because deleting a
         service needs the SYSTEM token, not the user's. The machine flag for the
         same reason as the quit step: the helper refuses to run when it looks
         portable, and a custom action must not depend on which environment it
         inherited. -->
    <CustomAction Id="RemoveCoreService" FileRef="THUnetExe"
                  ExeCommand="--machine service-admin uninstall"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Uninstall means the package is gone, so the machine state goes with it:
         `%ProgramData%\thunet` holds `credential.bin` and `key.bin`, which must
         not outlive the product. Same condition as RemoveCoreService, so an
         upgrade or a repair keeps the account and the sealed password. Runs
         after the service is deleted and before RemoveFiles, so the helper
         still exists and nothing holds the directory open. `Return="ignore"`:
         the helper itself refuses while the service is still registered, and a
         refused or failed purge must never abort an installation. The machine
         flag for the same reason as `RemoveCoreService`: a leftover
         `THUNET_STATE_DIR` would turn this into a delete of the portable state
         directory. -->
    <CustomAction Id="PurgeMachineState" FileRef="THUnetExe"
                  ExeCommand="--machine service-purge"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Put the package back the way the install found it, in one command: the
         core the quit step stopped (only if that step recorded it as running - a
         `demand` core the user started by hand comes back too, which the start
         type alone cannot express), then every window it closed, each in the
         state it answered (open on screen, or hidden in the tray).

         A commit action runs only when the transaction succeeded, and as SYSTEM
         because `WTSQueryUserToken` needs it and `service-restore` repairs the
         ImagePath and the state ACLs. The command reads and deletes both
         records, ignores one older than ten minutes, and skips sessions nobody
         is logged on to. -->
    <CustomAction Id="RestoreAfterUpdate" FileRef="THUnetExe"
                  ExeCommand="--machine service-restore"
                  Execute="commit" Impersonate="no" Return="ignore" />

    <!-- The installer's whole machine-wide half, in one command: ask every
         running window to quit and wait for them, then stop the service.
         Closing a window is not enough (a tray hides itself on WM_CLOSE) and
         killing it skips its shutdown, so the command raises the app's own
         machine-wide quit signal instead.

         One signal for the whole machine, not one per session: it is a
         `Global\` event that every machine-mode window polls, which is the only
         way to reach a tray in *another* session or *another user's* account —
         a session-scoped event cannot. It needs no running core; a window that
         ignores it (a portable setup deliberately does) keeps the old
         executable mapped and surfaces at InstallValidate.

         The stop belongs here for the same reason: the service holds
         `thunet.exe` open, and `InstallValidate` is exactly the action that
         checks those files — with the Restart Manager disabled it otherwise
         waits out its own "file in use" timeout, which measured ~56 s on a
         silent upgrade. The command waits for STOPPED and for the process to be
         gone itself, and writes down whether the core was running before it
         stopped it. `Return="check"` therefore covers both halves: windows that
         refuse to end, and a core that refuses to stop.

         Raising the signal and stopping the service need administrator rights,
         and this action can run unelevated (per-machine `Scope` only makes
         elevation required — it does not perform it; observed on a
         double-clicked install), so the command asks for elevation itself
         (UAC); that prompt is expected.

         `WixQuietExec` keeps the child's console hidden: a plain immediate
         custom action ran `taskkill` — a console program in the user's session
         — and flashed a black window on every install. (The all-sessions flag
         needs no fallback for older builds: no build without it has ever been
         installed.) -->
    <!-- The machine flag because an immediate custom action inherits the
         environment of whatever started msiexec: with a leftover
         `THUNET_STATE_DIR` the command would look for a portable endpoint that
         has nothing to do with the machine setup, and leave both the windows
         and the service alone. The flag clears the variable for this one
         invocation and leaves the rest of the process alone. -->
    <SetProperty Id="WixQuietExecCmdLine"
                 Value="&quot;[BINDIR]thunet.exe&quot; --machine quit --all-sessions --timeout 15000"
                 Before="QuitAllWindows" Sequence="execute" />
    <CustomAction Id="QuitAllWindows" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec" Execute="immediate" Return="check" />

    <InstallExecuteSequence>
      <!-- Before InstallValidate costs the files: a still-mapped image cannot be
           replaced with the Restart Manager disabled, and this one command ends
           both holders — the windows and the service. The `ServiceControl`
           entry on MainExe below still runs at StopServices on every install,
           upgrade and uninstall, which is the installer's own SCM client (no
           `sc.exe` or `net.exe`, hence no console window, and `Wait="yes"`
           holds the sequence until the service reports STOPPED), and it covers
           a core this command did not reach.

           `AND NOT UPGRADINGPRODUCTCODE` keeps the *removed* package from
           running it again during a major upgrade: its own sequence would find
           every window closed and the core stopped, and the quit step is
           write-only, so that second pass can only race the restore that comes
           later. A real uninstall still runs it, because that transaction has
           no `UPGRADINGPRODUCTCODE`. -->
      <Custom Action="QuitAllWindows" Before="InstallValidate"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Before RemoveFiles: the helper still has to exist. -->
      <Custom Action="RemoveCoreService" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeMachineState" After="RemoveCoreService"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- After the files are in place, not during an uninstall: the same
           condition the quit step above uses to run.

           `Before="InstallFinalize"` is the *scheduling* position, not when the
           action runs: a commit action has to be sequenced inside the script
           range (InstallInitialize … InstallFinalize), and the commit phase is
           what executes it last. Sequencing it after InstallFinalize is rejected
           at run time with error 2762 ("Unable to schedule operation") and fails
           the whole install with 1603 after the files are already committed. -->
      <Custom Action="RestoreAfterUpdate" Before="InstallFinalize"
              Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="LaunchApp" After="InstallFinalize"
              Condition="UILevel &gt;= 4 AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="THUnet">
        <!-- The executable lives in `bin` so the system PATH has one
             unambiguous directory to point at. -->
        <Directory Id="BINDIR" Name="bin" />
      </Directory>
    </StandardDirectory>
    <!-- The machine-wide Start Menu (`%ProgramData%`). WiX v5 has no
         `CommonProgramMenuFolder` standard directory, so the path is spelled
         out under `CommonAppDataFolder`; using `ProgramMenuFolder` instead
         would resolve to the profile of whoever ran the installer, which on a
         per-machine package leaves a second, user-only copy next to the real
         one. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="StartMenuMicrosoft" Name="Microsoft">
        <Directory Id="StartMenuWindows" Name="Windows">
          <Directory Id="StartMenuRoot" Name="Start Menu">
            <Directory Id="StartMenuPrograms" Name="Programs">
              <Directory Id="AppMenuFolder" Name="THUnet" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="THUnet" Level="1">
      <ComponentGroupRef Id="Binaries" />
    </Feature>

    <ComponentGroup Id="Binaries" Directory="BINDIR">
      <Component Id="MainExe" Guid="A0B2A2A3-1B5D-4A6E-8F10-5C1E2D3F4A5B">
        <File Id="THUnetExe" Source="$(var.BinPath)" KeyPath="yes">
          <Shortcut Id="StartMenuLnk" Directory="AppMenuFolder" Name="THUnet"
                    Description="THUnet Campus Network App"
                    WorkingDirectory="BINDIR" Icon="AppIcon" />
          <Shortcut Id="DesktopLnk" Directory="DesktopFolder" Name="THUnet"
                    Description="THUnet Campus Network App"
                    WorkingDirectory="BINDIR" Icon="AppIcon" />
        </File>
        <!-- The same executable is the CLI, so the directory joins the system
             PATH. `set` + `last` appends it only when it is missing and the
             uninstall removes it again; this is a per-machine package, which is
             what `System="yes"` needs. -->
        <Environment Id="PathEntry" Name="PATH" Value="[BINDIR]"
                     Part="last" Action="set" System="yes" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RemoveFolder Id="RemoveBinFolder" Directory="BINDIR" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <!-- Stop the core at StopServices (before InstallFiles) and at
             uninstall/repair. Native SCM calls, so nothing is spawned and
             nothing flashes; the service is deleted by the
             `service-admin uninstall` action, not here, because that one also
             removes the tray logon task. A machine without the service (the
             very first install) logs a warning and continues. -->
        <ServiceControl Id="StopCore" Name="thunet" Stop="both" Wait="yes" />
      </Component>
    </ComponentGroup>

  </Package>

</Wix>
