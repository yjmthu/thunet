#!/bin/sh
set -e

# The machine-wide half of an install is one command. `quit --all-sessions` ends
# every machine-mode window through a signal that needs no core, waits for their
# answers and writes them down, then stops the core and records whether it was
# running - so `postinst` can put the same windows and the same core back.
# Closing a window only hides it (a tray app has to), and killing it skips its
# shutdown; and the core has to go before the executable is replaced, because it
# would otherwise keep running the old image.
#
# Portable windows are left alone: they belong to a state directory, not to the
# machine setup, and the command still exits for this session alone.
#
# `|| true`: a wedged window must neither hang nor fail a removal. Linux keeps a
# mapped image alive, so the files free themselves anyway.
case "${1:-}" in
  remove|purge|upgrade|remove-in-future)
    /usr/bin/thunet --machine quit --all-sessions --timeout 3000 || true
    ;;
esac

exit 0
