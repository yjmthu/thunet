#!/bin/sh
set -e

# Ask every machine-mode window to end before the files are touched. Closing a
# window only hides it (a tray app has to), and killing it skips its shutdown.
#
# The command raises a machine-wide signal that needs no running core - an
# uninstall often runs with the service already stopped. Portable windows are
# left alone: they belong to a state directory, not to the machine setup.
#
# `|| true`: a wedged window must neither hang nor fail a removal. Linux keeps a
# mapped image alive, so the files free themselves anyway.
case "${1:-}" in
  remove|purge|upgrade|remove-in-future)
    /usr/bin/thunet --machine quit --all-sessions --timeout 3000 || true
    ;;
esac

if [ -d /run/systemd/system ]; then
  systemctl stop thunet.service || true
fi

exit 0
