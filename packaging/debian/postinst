#!/bin/sh
set -e

# Fresh install: the unit is unpacked but neither enabled nor started, exactly
# like the MSI, which leaves the service unregistered. Registering the core is
# the user's decision - *Start with the system* in the settings page, or
# `thunet service enable`, both of which ask for administrator rights - and
# starting it now is a separate, explicit `thunet service start` or the status
# page's *Start* button. `enable` would make a machine-wide core come back at
# every boot, and `restart` would put one into the 15-second network probe on a
# machine whose owner has not asked for it yet.
#
# Upgrade: `prerm` stopped the service before dpkg replaced the binary, so
# something has to bring the new one back, and the previous state decides
# whether it may. `is-enabled` is the same rule the Windows `service-resume`
# uses: start type `auto` -> start it again; autostart off -> leave it off, so
# an upgrade cannot resurrect a session the user turned off. `$2` is the
# previously configured version, which dpkg leaves empty on a first install.
if [ -d /run/systemd/system ]; then
  # dpkg unpacked the unit a moment ago; let the running manager see it so
  # `systemctl status thunet` works immediately.
  systemctl daemon-reload || true
  if [ "${1:-}" = configure ] && [ -n "${2:-}" ]; then
    if systemctl is-enabled --quiet thunet.service; then
      systemctl start thunet.service || true
    fi
  fi
fi

# Put back the windows `prerm` ended. They always come back in the tray, like a
# silent install: whether the package was installed interactively makes no
# difference. `quit-record` is written by the elevated quit command and names
# one uid per window; a record older than ten minutes belongs to an installation
# that never completed and is dropped instead.
record=/run/thunet-quit-record
if [ "${1:-}" = configure ]; then
  if [ -n "${2:-}" ] && [ -r "$record" ]; then
    now=$(date +%s%3N 2>/dev/null || echo 0)
    at=$(awk '$1 == "at" { print $2; exit }' "$record")
    if [ -n "$at" ] && [ "$now" -gt 0 ] && [ $((now - at)) -le 600000 ]; then
      for uid in $(awk '$1 == "uid" { print $2 }' "$record" | sort -u); do
        user=$(getent passwd "$uid" | cut -d: -f1)
        [ -n "$user" ] || continue
        # The user manager knows the graphical session's DISPLAY/WAYLAND_DISPLAY;
        # a session without a manager (nobody logged in) is simply skipped.
        systemd-run --user --machine="$user@.host" --collect --quiet \
          /usr/bin/thunet --minimized >/dev/null 2>&1 || true
      done
    fi
  fi
  # A record from an earlier uninstall or a failed transaction must not be
  # waiting for the next one.
  rm -f "$record"
fi

exit 0
