#!/bin/sh
set -e

# Fresh install: the unit is unpacked but neither enabled nor started, exactly
# like the MSI, which leaves the service unregistered. Registering the core is
# the user's decision - *Start with the system* in the settings page, or
# `thunet service enable`, both of which ask for administrator rights - and
# starting it now is a separate, explicit `thunet service start` or the status
# page's *Start* button. `enable` would make a machine-wide core come back at
# every boot, and a start would put one into the 15-second network probe on a
# machine whose owner has not asked for it yet.
#
# Upgrade: the machine-wide quit in `prerm` stopped the core and recorded
# whether it was running, in /run/thunet-core-was-running. `service-restore`
# reads that marker and starts the new binary only then, so the state the user
# chose survives the install: a core that was up comes back, one that was stopped
# stays stopped. The running state decides, never `is-enabled`, so a machine
# whose owner turned autostart off but started the core by hand keeps working
# across the upgrade. `$2` is the previously configured version, which dpkg
# leaves empty on a first install.
if [ -d /run/systemd/system ]; then
  # dpkg unpacked the unit a moment ago; let the running manager see it so
  # `systemctl status thunet` works immediately and `service-restore` below
  # restarts this build.
  systemctl daemon-reload || true
fi

# Put the package back the way the install found it, in one command: the core
# (if `prerm` found it running), then each window in the state it answered. The
# command reads /run/thunet-quit-record and /run/thunet-core-was-running, both
# written by the elevated quit in `prerm`, ignores anything older than ten
# minutes, and starts each user's window through that user's systemd manager -
# `postinst` itself has no way into a graphical session. `|| true`: a wedged
# start must not fail an otherwise good install.
if [ "${1:-}" = configure ] && [ -n "${2:-}" ]; then
  /usr/bin/thunet --machine service-restore || true
fi

exit 0
